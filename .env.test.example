# Variables para npm run test:integration (tests/repository/, tests/integration/).
# Copiar a .env.test tras `npx supabase start` (imprime URL/anon key/service role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Usuario admin de prueba (se crea automaticamente si no existe, ver
# tests/helpers/admin-session.ts). No usar credenciales reales.
TEST_ADMIN_EMAIL=admin.test@aitor-os.local
TEST_ADMIN_PASSWORD=test-admin-password-123
