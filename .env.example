# Supabase self-hosted (local: `npx supabase start` imprime los valores reales)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO scripts de administracion. Nunca en el cliente, nunca como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionales — Dashboard/Inicio funcionan igual sin ellas (sin bloque de
# actividad de GitHub). GITHUB_USERNAME decide de quien mostrar la
# actividad; GITHUB_TOKEN solo evita el rate limit anonimo de la API.
GITHUB_USERNAME=
GITHUB_TOKEN=
