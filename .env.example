# Supabase self-hosted (local: `npx supabase start` imprime los valores reales)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO scripts de administracion. Nunca en el cliente, nunca como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — usado por el proxy /api/github (Fase 8) para evitar rate limits.
GITHUB_TOKEN=
